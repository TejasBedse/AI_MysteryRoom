{
  "name": "ai-mystery-room",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.8.3" }
}
